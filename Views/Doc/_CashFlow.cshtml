<style>

    table {
        border-collapse: collapse;
        font-size: 11px;
    }

        table td {
            padding: 0px !important;
        }

    .top-header {
        width: 100%;
        border: 1px solid #000;
    }

    .detail-1, .detail-2, .detail-3, .detail-4, .detail-5, .detail-6 {
        width: 100%;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
