    }

    .col-2 {
        font-weight: bold;
    }

    .col-3 {
        border-left: 1px solid #000;
        width: 150px;
        font-weight: bold;
    }

    .text-center {
        text-align: center;
    }

    .text-right {
        text-align: right;
        padding-right: 5px !important;
    }

    .text-left {
        text-align: left !important;
        padding-left: 5px !important;
    }

    table td {
        padding-top: 1px !important;
        padding-left: 3px !important;
    }

    .bold {
        font-weight: bold;
    }

    td.topic {
        text-align: right;
        width: 110px;
        font-weight: bold;
        font-size: 12px;
    }

    .col-doc-date {
        width: 200px;
    }

    .address {
        padding: 5px;
        font-size: 9px;
    }

    .detail-3 td.topic {
        width: 200px;
    }

    .detail-3 td.content {
        width: 170px
    }

    .detail-4 td.content {
        width: 50px !important;
    }

    div.spirate {
        width: 99.8%;
        height: 1px;
        border: 1px solid #000;
    }

    .detail-5 td.header {
        border: 1px solid #000;
        text-align: center;
        font-weight: bold;
        padding-top: 5px !important;
        padding-bottom: 5px !important;
    }

    div.arrow {
        display: inline-block;
        margin-left: 50px;
        margin-right: 50px;
    }

    .font-lg {
        font-size: 16px !important;
    }

    .font-lg-customer {
        font-size: 14px !important;
    }

    .border-bottom {
        border-bottom: 1px solid #000;
    }

    div.box-line {
        border-bottom: 1px solid #000;
        height: 13px;
        margin-left: 5px;
        display: inline-block;
        width: 150px;
    }

    .wrap-content .box-topic {
