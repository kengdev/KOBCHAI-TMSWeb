@model TMSWeb.Models.Entities.LOG.TblJobMaster
@using (Html.BeginForm("AddContainer", "Order", FormMethod.Post, new { id = "frmAddContainer", onsubmit = "return OnValidate()" }))
{
    @Html.HiddenFor(m => m.JobCode)
    @Html.HiddenFor(m => m.CustomerCode, new { id = "txtCustomerCode" })
    @Html.Hidden("acronym")
    @Html.Hidden("valueChange")
    <div class="form-body">
        <div class="row">
            <div class="col-md-3">
                <label>ประเภทงาน</label>
                <div class="mt-radio-inline">
                    <label class="mt-radio">
                        <input type="radio" name="JobType" class="rdoJobType" value="CONTAINER" checked> Container
                        <span></span>
                    </label>
                    <label class="mt-radio">
                        @Html.RadioButtonFor(m => m.JobType, "DOMESTIC", new { @Class = "rdoJobType", Id = "rdoExport" }) Domestic
                        <span></span>
                    </label>
                </div>
            </div>
            <div class="col-md-5">
                <label>ประเภทขา</label>
                <div class="mt-radio-inline">
                    <label class="mt-radio">
                        <input type="radio" name="TradeType" class="rdoTradeType" value="IMPORT" checked> Import
                        <span></span>
                    </label>
                    <label class="mt-radio">
                        @Html.RadioButtonFor(m => m.TradeType, "EXPORT", new { @Class = "rdoTradeType", Id = "rdoExport" }) Export
                        <span></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-7">
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label>
                                ค้นหาลูกค้า
                                <span class="required"> * </span>
                            </label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.CostCode, new
                                {
                                    @Class = "form-control customer-cost",
                                    id = "txtCostCode",
                                    autocomplete = "off"
                                })
                                <span class="input-group-btn">
                                    <button class="btn red" type="button"
                                            onclick="searchCustomerFunc('cont')">
                                        ค้นหา
                                    </button>
                                </span>
                            </div>
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label>ชื่อลูกค้า</label>
                        @Html.TextBox("txtCustomerName", null, new { @Class = "form-control", disabled = "Disabled" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>รหัสสถานที่รับตู้</label>
                            <span class="required"> * </span>
                            <div class="input-group">
                                @Html.TextBox("txtStartCode", null, new { @Class = "form-control", autocomplete = "off" })
                                <span class="input-group-btn">
                                    <button class="btn red" type="button" onclick="searchPlaceFunc('S')">ค้นหา</button>
                                </span>
                            </div>
                            <span class="help-block help-group"></span>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label>ชื่อสถานที่รับตู้</label>
                        @Html.TextBox("txtDisStartName", null, new { @Class = "form-control", disabled = "Disabled" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>สถานที่คืนตู้</label>
                            <div class="input-group">
                                @Html.TextBox("txtFinishCode", null, new { @Class = "form-control", autocomplete = "off" })
                                <span class="input-group-btn">
                                    <button class="btn red" type="button" onclick="searchPlaceFunc('F')">ค้นหา</button>
                                </span>
                            </div>
                            <span class="help-block help-group"></span>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label>ชื่อสถานที่คืนตู้</label>
                        @Html.TextBox("txtDisFinishName", null, new { @Class = "form-control", disabled = "Disabled" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <label>ชื่อสถานที่เปิด/บรรจุ/ลงท่า</label>
                        @Html.Hidden("txtMissionCode", null, new { @Class = "form-control", autocomplete = "off" })
                        @Html.TextBox("txtDisMissionName", null, new { @Class = "form-control", disabled = "Disabled" })
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                ขนาดตู้
                                <span class="required"> * </span>
                            </label>
                            <br />
                            @Html.DropDownList("ContainerSizeCode", null, "-----เลือก-----", new
                            {
                                @Class = "form-control",
                                id = "container_kind"
                            })
                            <span class="help-block help-filter"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-12">
                                <label>อื่น ๆ ระบุ</label>
                                @Html.TextBox("txtOther", null, new
                                {
                                    @Class = "form-control",
                                    id = "txtOther",
                                    Disabled = "Disabled",
                                    autocomplete = "off"
                                })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label>ประเภทงาน</label>
                        <div class="mt-radio-inline">
                            <label class="mt-radio">
                                @Html.RadioButtonFor(m => m.BookingPeriod, "M", new { @Class = "rdoPeriod", Id = "rdoMorning" }) เช้า
                                <span></span>
                            </label>
                            <label class="mt-radio">
                                @Html.RadioButtonFor(m => m.BookingPeriod, "A", new { @Class = "rdoPeriod", Id = "rdoAfternoon" }) บ่าย
                                <span></span>
                            </label>
                            <label class="mt-radio">
                                @Html.RadioButtonFor(m => m.BookingPeriod, "E", new { @Class = "rdoPeriod", Id = "rdoEvening" }) เย็น
                                <span></span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                วันรับตู้
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.JobDate, new
                            {
                                @Class = "form-control datepicker",
                                id = "txtJobDate",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                วันโหลดตู้
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.LoadingDate, new
                            {
                                @Class = "form-control datetimepicker",
                                id = "txtLoadingDate",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Closing Time
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.ClosingTime, new
                            {
                                @Class = "form-control datetimepicker",
                                id = "txtClosing",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Invoice/Job No.
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.JobInvoice, new
                            {
                                @Class = "form-control",
                                id = "txtInvoice",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Booking No
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.BookingNo, new
                            {
                                @Class = "form-control",
                                id = "txtBookingNo",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                จำนวนตู้
                                <span class="required"> * </span>
                            </label>
                            @Html.TextBoxFor(m => m.ContainerAmount, new
                            {
                                @Class = "form-control form-number",
                                id = "txtAmount",
                                autocomplete = "off"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                ประเภทรถ
                                <span class="required"> * </span>
                            </label>
                            @Html.DropDownList("TruckTypeCode", null, "-----เลือก-----", new
                            {
                                @Class = "form-control",
                                id = "truck_type"
                            })
                            <span class="help-block"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <label>หมายเหตุของลูกค้า</label>
                        @Html.TextBoxFor(m => m.CustomerRemark, new
                        {
                            @Class = "form-control",
                            autocomplete = "off"
                        })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <label>หมายเหตุ</label>
                        @Html.TextBoxFor(m => m.JobRemark, new
                        {
                            @Class = "form-control",
                            autocomplete = "off"
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <div class="row pull-right">
            <div class="col-md-12">
                <div class="tools-action">
                    <a href="/order/">กลับหน้าหลัก</a> |
                    <button type="submit" class="btn green">บันทึกข้อมูล</button>
                </div>
            </div>
        </div>
    </div>
}