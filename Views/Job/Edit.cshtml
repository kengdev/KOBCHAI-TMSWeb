@model TMSWeb.Models.Entities.LOG.TblJobDetail
@{
    ViewBag.Title = "ข้อมูลงาน";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = (TMSWeb.Models.Entities.LOG.ViewJobListActive)ViewBag.Data;
    var allowanceData = (List<TMSWeb.Models.ViewModels.CashflowViewModel>)ViewBag.Allowance;
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/profile/todo-2.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        th {
            font-size: 13px !important;
            text-align: center;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }
    </style>
}
<div class="col-md-12 ">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-pencil"></i>
                <span class="caption-subject bold uppercase"> แก้ไขรายการ</span>
                <span class="caption-helper">[เลขที่ @Model.JobCode]</span>
            </div>
        </div>
        @using (Html.BeginForm("EditOrderTruck", "Job", FormMethod.Post, new { id = "frmEdit", onsubmit = "return OnValidate()" }))
        {
            @Html.Hidden("job_allowance_id", data.Id)
            @Html.Hidden("round_trip", data.RoundTrip)
            @Html.HiddenFor(m => m.JobDetailCode)
            @Html.HiddenFor(m => m.DriverCode)
            @Html.HiddenFor(m => m.CostValue)
            @Html.HiddenFor(m => m.ContainerNo)
            @Html.HiddenFor(m => m.SealNo)
            @Html.HiddenFor(m => m.TareWeight)
            @Html.HiddenFor(m => m.JobStatus)
            @Html.HiddenFor(m => m.TrailerLicense)
            @Html.HiddenFor(m => m.TrackingStatus)
            @Html.HiddenFor(m => m.JobCode)
            @Html.HiddenFor(m => m.StartPlaceCode)
            @Html.HiddenFor(m => m.MissionPlaceCode)
            @Html.HiddenFor(m => m.FinishPlaceCode)
            @Html.HiddenFor(m => m.SupplierInvoice)
            @Html.HiddenFor(m => m.IsDocument)
            @Html.HiddenFor(m => m.IsBilling)
            @Html.HiddenFor(m => m.IsPayment)
            @Html.HiddenFor(m => m.IsEnabled)
            @Html.HiddenFor(m => m.CreateDate)
            @Html.HiddenFor(m => m.CreateBy)
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-7">
                            <div class="table-scrollable table-scrollable-borderless">
                                <table class="table table-light">
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ชื่องาน</span>
                                        </td>
                                        <td> @data.JobName</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td>
                                            <span class="font-green-jungle bold">@data.StartName </span>
                                            <i class="fad fa-arrow-alt-right" style="margin-left:20px;margin-right:20px;"></i>
                                            <span class="font-red-flamingo bold">@data.MissionName</span>
                                            <i class="fad fa-arrow-alt-right" style="margin-left:20px;margin-right:20px;"></i>
                                            <span class="font-green-jungle bold">@data.FinishName</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">รับตู้</span>
                                        </td>
                                        <td> @data.JobDate.ToString("dd-MM-yyyy HH:mm") </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">เปิด/บรรจุ</span>
                                        </td>
                                        <td> @data.LoadingDate.ToString("dd-MM-yyyy HH:mm") </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ประเภทงาน/ขนาด</span>
                                        </td>
                                        <td>
                                            <div class="font-red-flamingo">@data.JobType / @data.ContainerAmount x @data.ContainerSizeName</div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Booking No.</span>
                                        </td>
                                        <td> @data.BookingNo </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Invoice/Job</span>
                                        </td>
                                        <td> @data.JobInvoice</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ประเภท</span>
                                        </td>
                                        <td> @data.TruckTypegroupName</td>
                                    </tr>
                                    <tr>
                                        <td class="topic" style="vertical-align:top;">
                                            <span class="font-green-sharp">ทะเบียน/คนขับ</span>

                                        </td>
                                        <td>
                                            @foreach (var item in allowanceData)
                                            {

                                                <div>
                                                    <span> @item.job_date.ToString("yyyy-MM-dd")</span>
                                                    <i class="fa fa-caret-right font-red-intense"></i>
                                                    @item.license
                                                    <i class="fad fa-dot-circle font-green-jungle"></i>
                                                    @item.driver |
                                                    <span class="bold font-red-mint">@item.cashflow.ToString("#,##0.00")</span>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">หมายเหตุ</span>
                                        </td>
                                        <td> @data.JobRemark </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="col-md-5">
                            @if (data.RoundTrip != "C")
                            {
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="mt-radio-inline">
                                            <label class="mt-radio">
                                                <input type="radio" name="change_condition" class="change_condition" value="C" checked> เปลี่ยนพนักงานขับรถ
                                                <span></span>
                                            </label>
                                            <label class="mt-radio">
                                                <input type="radio" name="change_condition" class="change_condition" value="W" > รอการจัดรถใหม่
                                                <span></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>
                                            บริษัทผู้รับงาน
                                        </label>
                                        <br />
                                        @Html.DropDownList("new_supplier_code", null, new
                                        {
                                            id = "supplier_code",
                                            @Class = "form-control"
                                        })
                                        <span class="help-block help-filter"></span>
                                    </div>
                                </div>
                            </div>

                            @if (Model.SupplierCodeNavigation.FleetTypeCode != "F1")
                            {
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group">
                                            <label>
                                                ทะเบียนรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_truck_code", null, "-----เลือก-----", new
                                            {
                                                id = "truck_code",
                                                @Class = "form-control",
                                                disabled = "Disabled"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <div class="form-group">
                                            <label>
                                                พนักงานขับรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_driver_code", null, "-----เลือก-----", new
                                            {
                                                id = "driver_code",
                                                @Class = "form-control",
                                                disabled = "Disabled"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                                <hr/>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                เงินสำรองจ่าย<span class="required"> * </span>
                                            </label>
                                            <br />
                                            @Html.TextBox("cashflow", null, new
                                            {
                                                @Class = "form-control",
                                                autocomplete = "off",
                                                disabled = "Disabled"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group">
                                            <label>
                                                ทะเบียนรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_truck_code", null, "-----เลือก-----", new
                                            {
                                                id = "truck_code",
                                                @Class = "form-control"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <div class="form-group">
                                            <label>
                                                พนักงานขับรถ
                                            </label>
                                            <br />
                                            @Html.DropDownList("new_driver_code", null, "-----เลือก-----", new
                                            {
                                                id = "driver_code",
                                                @Class = "form-control"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                                <hr/>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>
                                                เงินสำรองจ่าย<span class="required"> * </span>
                                            </label>
                                            <br />
                                            @Html.TextBox("cashflow", null, new
                                            {
                                                @Class = "form-control",
                                                autocomplete = "off"
                                            })
                                            <span class="help-block help-filter"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section scripts
{
    <script src="~/js/autocomplete/bootstrap3-typeahead.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function ($) {
            $("#frmEdit").ajaxForm(function (data) {
                killOverlayForm();

                if (data.result === true) {
                    $.alert.open("info", data.resultMessage, function (r) {
                        window.opener.reloadRow();
                        window.close();
                    });
                } else {
                    $.alert.open("error", data.resultMessage);
                }
            });

            $("#supplier_code").change(function () {
                var supplier = $(this).val();
                $.post(
                    "/Job/GetSupplierByCode",
                    {
                        code: supplier
                    },
                    function (result) {
                        if(result.fleetTypeCode == 'F1'){
                            $("#truck_code").prop("disabled", false);
                            $("#driver_code").prop("disabled", false);
                            $('#cashflow').prop("disabled", false);
                            setDriverDropDown(supplyer);
                        }
                        else{
                            $("#truck_code").val("");
                            $("#driver_code").val("");
                            $('#cashflow').val("");

                            $("#truck_code").prop("disabled", true);
                            $("#driver_code").prop("disabled", true);
                    
                            $('#cashflow').prop("disabled", true);
                        }
                    }
                );
            });

            $("#truck_code").change(function () {
                var truck = $(this).val();

                setSelectDriver(truck);
            });

            $('.change_condition').change(function(){
                var condition = $(this).val();
                if(condition == 'C')
                {
                    $("#supplier_code").prop("disabled", false);
                    $("#truck_code").prop("disabled", false);
                    $("#driver_code").prop("disabled", false);
                    $("#cashflow").prop("disabled", false);
                }
                else{
                    $("#supplier_code").prop("disabled", true);
                    $("#truck_code").prop("disabled", true);
                    $("#driver_code").prop("disabled", true);
                    $("#cashflow").prop("disabled", true);
                }
            });
        }(jQuery));

        function setDriverDropDown(supplyer) {
            $("#driver_code option").remove();

            $.post(
                "/Job/GetDriverData",
                {driver_code: $('#DriverCode').val()},
                function (data) {
                    $("#driver_code").append(
                        "<option value=''>-----เลือก-----</option>"
                    );

                    $.each(data.result, function (i, item) {
                        var option =
                            "<option value='" +
                            item.driver_code +
                            "'>" +
                            item.fullname +
                            "</option>";

                        $("#driver_code").append(option);
                    });

                    if (supplyer !== "SP26001") {
                        $("#driver_code").append(
                            "<option value='DV000000'>ไม่ระบุ</option>"
                        );
                    }
                }
            );
        }

        function setSelectDriver(truck) {
            $.post(
                "/Order/GetTruckDriverByTruckCode",
                {
                    code: truck
                },
                function (result) {
                    $("#driver_code").val(result.driver_code);
                }
            );
        }


        function OnValidate() {
            var result = 0;
            var condition = $('input[name="change_condition"]:checked').val();
            var supplier = $("#supplyer_code").val();
            var truck = $("#truck_code").val();
            var driver = $("#driver_code").val();

            var truckElement = $("#truck_code");
            var driverElement = $("#driver_code");

            if(condition != 'W'){
                if (supplier === "SP26001") {
                    if (truck === "") {
                        truckElement
                            .closest("div.form-group")
                            .addClass("has-error");

                        truckElement
                            .closest("div.form-group")
                            .find("span.help-block")
                            .html("กรุณาเลือกทะเบียนรถ");

                        result++;
                    } else {
                        truckElement
                            .closest("div.form-group")
                            .removeClass("has-error");

                        truckElement
                            .closest("div.form-group")
                            .find("span.help-block")
                            .html("");
                    }

                    if (driver === "") {
                        driverElement
                            .closest("div.form-group")
                            .addClass("has-error");

                        driverElement
                            .closest("div.form-group")
                            .find("span.help-block")
                            .html("กรุณาเลือกพนักงานขับรถ");

                        result++;
                    } else {
                        driverElement
                            .closest("div.form-group")
                            .removeClass("has-error");

                        driverElement
                            .closest("div.form-group")
                            .find("span.help-block")
                            .html("");
                    }
                } else {
                    truckElement
                        .closest("div.form-group")
                        .removeClass("has-error");

                    truckElement
                        .closest("div.form-group")
                        .find("span.help-block")
                        .html("");

                    driverElement
                        .closest("div.form-group")
                        .removeClass("has-error");

                    driverElement
                        .closest("div.form-group")
                        .find("span.help-block")
                        .html("");
                }
            }

            if (result === 0) {
                overLayForm();
                return true;
            }

            return false;
        }
    </script>
}