@model TMSWeb.Models.CancelJobModel
@{
    ViewBag.Title = "Add";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
    var data = (TMSWeb.Models.Entities.LOG.ViewJobListActive)ViewBag.Data;
    var allowanceData = (List<TMSWeb.Models.Entities.LOG.TblJobAllowance>)ViewBag.Allowance;
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/profile/todo-2.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        th {
            font-size: 13px !important;
            text-align: center;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }
    </style>
}
<div class="col-md-12 ">
    <!-- BEGIN SAMPLE FORM PORTLET-->
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <i class="fad fa-times-circle"></i>
                <span class="caption-subject bold uppercase"> ยกเลิกงาน</span>
                <span class="caption-helper">[เลขที่ @Model.job_detail_code]</span>
            </div>
        </div>
        @using (Html.BeginForm("CancelJobData", "Job", FormMethod.Post, new
        {
            role = "form",
            id = "frmEdit",
            onsubmit =
        "return OnValidate()"
        }))
        {
            @Html.HiddenFor(m => m.job_detail_code)
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="table-scrollable table-scrollable-borderless">
                                <table class="table table-light">
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ชื่องาน</span>
                                        </td>
                                        <td> @data.JobName</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td>
                                            <span class="font-green-jungle bold">@data.StartName </span>
                                            <i class="fad fa-arrow-alt-right" style="margin-left:20px;margin-right:20px;"></i>
                                            <span class="font-red-flamingo bold">@data.MissionName</span>
                                            <i class="fad fa-arrow-alt-right" style="margin-left:20px;margin-right:20px;"></i>
                                            <span class="font-green-jungle bold">@data.FinishName</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">รับตู้</span>
                                        </td>
                                        <td> @data.JobDate.ToString("dd-MM-yyyy HH:mm") </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">เปิด/บรรจุ</span>
                                        </td>
                                        <td> @data.LoadingDate.ToString("dd-MM-yyyy HH:mm") </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ประเภทงาน/ขนาด</span>
                                        </td>
                                        <td>
                                            <div class="font-red-flamingo">@data.JobType / @data.ContainerAmount x @data.ContainerSizeName</div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Booking No.</span>
                                        </td>
                                        <td> @data.BookingNo </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">Invoice/Job</span>
                                        </td>
                                        <td> @data.JobInvoice</td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">ประเภท</span>
                                        </td>
                                        <td> @data.TruckTypegroupName</td>
                                    </tr>
                                    <tr>
                                        <td class="topic" style="vertical-align:top;">
                                            <span class="font-green-sharp">ทะเบียน/คนขับ</span>
                                        </td>
                                        <td>
                                            @foreach (var item in allowanceData)
                                            {
                                                <div>
                                                    <span> @item.JobDate.ToString("yyyy-MM-dd")</span>
                                                    <i class="fa fa-caret-right font-red-intense"></i>
                                                    @item.TruckCodeNavigation.TruckLicense
                                                    <i class="fad fa-dot-circle font-green-jungle"></i>
                                                    @item.DriverCodeNavigation.DriverFullname
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="topic">
                                            <span class="font-green-sharp">หมายเหตุ</span>
                                        </td>
                                        <td> @data.JobRemark </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>
                                            ค่าเที่ยว (สำหรับคิดเงินลูกค้า)<span class="required"> * </span>
                                        </label>
                                        @Html.TextBoxFor(m => m.trip_cost, new
                                        {
                                            @Class = "form-control",
                                            autocomplete =
                                        "off"
                                        })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>
                                            ค่าเที่ยว (สำหรับจ่ายรถ)<span class="required"> * </span>
                                        </label>
                                        @Html.TextBoxFor(m => m.supplier_cost, new
                                        {
                                            @Class = "form-control",
                                            autocomplete = "off"
                                        })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>
                                            ค่าเที่ยว (สำหรับพนักงานขับรถ)<span class="required"> * </span>
                                        </label>
                                        @Html.TextBoxFor(m => m.driver_cost, new
                                        {
                                            @Class = "form-control",
                                            autocomplete = "off"
                                        })
                                        <span class="help-block"></span>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row pull-right">
                        <div class="col-md-12">
                            <div class="tools-action">
                                <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                <button type="submit" class="btn green">บันทึกข้อมูล</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script src="~/js/autocomplete/bootstrap3-typeahead.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function ($) {
        $("#frmEdit").ajaxForm(function (data) {
        killOverlayForm();
        if (data.result === true) {
        $.alert.open('info', "บันทึกข้อมูลเรียบร้อยแล้ว", function (r) {
        window.opener.reloadRow();
        window.close();
        });
        } else {
        $.alert.open('error',
        "<div>เกิดข้อผิดพลาดระหว่างการทำงาน</div><div style='margin-top:-30px'> กรุณาลองใหม่อีกครั้ง หรือติดต่อผู้ดูแลระบบ</div>"
        );
        }
        });
        }(jQuery));

        function OnValidate() {
        var result = 0;
        var trip_element = $('#trip_cost');
        var driver_element = $('#driver_cost');
        if (trip_element.val() == '') {
        trip_element.closest("div.form-group").addClass("has-error");
        trip_element.closest('div.form-group').find('span.help-block').html('กรุณาระบุค่าเที่ยว หากไม่มีใส่ 0');
        result++;
        } else {
        trip_element.closest("div.form-group").removeClass("has-error");
        trip_element.closest('div.form-group').find('span.help-block').html('');
        }

        if (driver_element.val() == '') {
        driver_element.closest("div.form-group").addClass("has-error");
        driver_element.closest('div.form-group').find('span.help-block').html('กรุณาระบุค่าเที่ยว หากไม่มีใส่ 0');
        result++;
        } else {
        driver_element.closest("div.form-group").removeClass("has-error");
        driver_element.closest('div.form-group').find('span.help-block').html('');
        }

        if (result === 0) {
        overLayForm();
        return true;
        } else {
        return false;
        }
        }
    </script>
}