@model TMSWeb.Models.Entities.LOG.ViewJobListActive
@{
    ViewBag.Title = "Finish";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
    <style>
        .table td {
            font-size: 13px;
        }

        .bordered {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }

        .data-bootstrap th {
            font-size: 13px !important;
            text-align: center;
            background: #e8e8e8;
        }

        td.topic {
            width: 120px !important;
            text-align: right;
        }

        a.closed {
            font-size: 16px !important;
            color: red;
        }

            a.closed:hover {
                color: #8e0505
            }

        .caption-helper {
            font-size: 13px;
            color: #929292
        }

        .form-body {
            padding-top: 0 !important;
        }

        .form-actions {
            padding: 15px 0 0 0 !important;
            margin: 0;
        }

        .table-responsive {
            overflow-y: visible !important;
            z-index: 999;
        }

        .form-box, .nameAdvance {
            height: 25px !important;
        }

        th {
            text-align: left !important;
        }
    </style>
}
<div class="col-md-12 ">
    <div class="portlet light bordered">
        <div class="portlet-title">
            <div class="caption">
                <span class="caption-subject bold uppercase"> รับเอกสารงาน</span>
                <span class="caption-helper">[เลขที่ @Model.JobDetailCode]</span>
            </div>
        </div>
        @using (Html.BeginForm("Finish", "Job", FormMethod.Post, new { role = "form", id = "frmFinish", onsubmit = "return OnValidate()" }))
        {
            @Html.Hidden("allowance_id", Model.Id)
            @Html.Hidden("job_detail_code", Model.JobDetailCode)
            <div class="portlet-body form">
                <div>
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-3">
                                <span class="bold font-blue">@Model.SupplierName</span><br/>
                                <span class="bold font-blue">@Model.TruckLicense | @Model.DriverFullname</span>
                            </div>
                            @if (Model.FleetTypeCode == "F1")
                            {
                                <div class="col-md-3">
                                    <label class="bold">ยอดใช้จ่าย : </label>
                                    <span class="font-red bold" id="totalNet">@Model.CashFlow.Value.ToString("#,##0.00")</span> /
                                    <span class="font-green-jungle bold">@Model.CashFlow.Value.ToString("#,##0.00")</span> 
                                </div>
                            }
                            else
                            {
                                <div class="col-md-3">
                                    <label class="bold">ยอดใช้จ่าย : </label>
                                    <span class="font-red bold" id="totalNet">0.00</span>
                                </div>
                            }
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-md-6">
                                @await Component.InvokeAsync("EntryAdvance", new { code = Model.JobDetailCode, driver = Model.DriverCode })
                            </div>
                            <div class="col-md-6">
                                @await Component.InvokeAsync("EntryCashing", new { code = Model.JobDetailCode })
                            
                                <br/>
                                <div class="row">
                                   <div class="col-sm-3 col-md-3 col-lg-3">
                                       <label class="font-sm">เบอร์ตู้</label>
                                    </div>
                                    <div class="col-sm-9 col-md-9 col-lg-9">
                                        <div class="form-group">
                                            @Html.TextBox("container_no", Model.ContainerNo, new { @Class = "form-control input-sm", autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                   <div class="col-sm-3 col-md-3 col-lg-3">
                                       <label class="font-sm">เบอร์ซีล</label>
                                    </div>
                                    <div class="col-sm-9 col-md-9 col-lg-9">
                                        <div class="form-group">
                                            @Html.TextBox("seal_no", Model.ContainerNo, new { @Class = "form-control input-sm", autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                   <div class="col-sm-3 col-md-3 col-lg-3">
                                       <label class="font-sm">Tare weight</label>
                                    </div>
                                    <div class="col-sm-9 col-md-9 col-lg-9">
                                        <div class="form-group">
                                            @Html.TextBox("tare_weight", Model.TareWeight, new { @Class = "form-control input-sm", autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
                                <hr/>
                                <div class="row">
                                    @if (Model.FleetTypeCode == "F1")
                                    {
                                    <div class="col-sm-6 col-md-6 col-lg-6">
                                        <div class="form-group">
                                            <label>ค่าแรงพนักงานขับรถ</label>
                                             <div class="form-group">
                                                @Html.TextBox("driver_trip", Model.DriverAllowance, new { @Class = "form-control input-sm", autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>
                                    }
                                    <div class="col-sm-6 col-md-6 col-lg-6">
                                        <div class="form-group">
                                            <label>ค่าเที่ยว</label>
                                             <div class="form-group">
                                                @Html.TextBox("supplier_trip", Model.SupplierAllowance, new { @Class = "form-control input-sm", autocomplete = "off" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <div class="row pull-right">
                            <div class="col-md-12">
                                <div class="tools-action">
                                    <a href="javascript:;" onclick="window.close();">ยกเลิก</a> |
                                    <button type="submit" class="btn green">บันทึกข้อมูล</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts
{
    <script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        (function ($) {
            $("#frmFinish").ajaxForm(function (data) {
                killOverlayForm();
                if (data.result) {
                    $.alert.open('info', data.resultMessage, function (r) {
                        window.opener.reloadRow();
                        window.close();
                    });
                } else {
                    $.alert.open('error', data.resultMessage);
                }
            });

            $(document.body).delegate('.cashing-val', 'change', function () {
                var cost = 0;
                var x = $(this).val();
                var arr = x.split('+');
                $.each(arr, function (index, value) {
                    if (value != '') {
                        cost = cost + parseFloat(value);
                    }
                });

                if (cost > 0) {
                    $(this).val(cost);
                }
                TotalSum()
            });

            $(document.body).delegate('.advance-val', 'change', function () {
                var cost = 0;
                var x = $(this).val();
                var arr = x.split('+');
                $.each(arr, function (index, value) {
                    if (value != '') {
                        cost = cost + parseFloat(value);
                    }
                });

                if (cost > 0) {
                    $(this).val(cost);
                }
                TotalSum()
            });

            $(document).on('keyup', '.form-box', function () {
                TotalSum();
            });
        }(jQuery));

        function addCashing() {
            var row = '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeCashingItem(this)><i class="icon icon-close"></a></td>'
            row += '<td><input type="text" class="form-control nameCashing" name="nameCashing[]" autocomplete="Off"></td>';
            row += '<td><input type="text" class="form-control cashing-val form-box" name="valCashing[]" value="0" autocomplete="Off"/></td></tr>'
            $('#cashing-table').append(row);
        }

        function addAdvance() {
            var row = $('#advance-table tr td').html();
            if (row == "No matching records found") {
                $('#advance-table tr').remove();
            }
            var row = '<tr><td style="text-align:center;vertical-align:middle;"><a href="#" class="closed" onclick=removeAdvanceItem(this)><i class="icon icon-close"></a></td>'
            row += '<td><input type="text" class="form-control nameAdvance" name="nameAdvance[]" autocomplete="Off"></td>';
            row += '<td><input type="text" class="form-control other-val form-box" name="valAdvance[]" value="0" autocomplete="Off"/></td></tr>'
            $('#advance-table').append(row)
        }

        function removeCashingItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalSum();
        }

        function removeAdvanceItem(e) {
            //var val = $(e).closest("td").next().next().find("input").val();
            $(e).parent().parent().remove()
            TotalSum();
        }

        function TotalSum() {
            let total = 0;
            $('.form-box:not(:disabled)').each(function () {
                let value = $(this).val();
                total += parseFloat(value) || 0;
            });

            $('#totalNet').text(number_format(total));
        }

        function OnValidate() {
            $(".form-box").each(function () {
                if ($(this).val() == '') {
                    $(this).val('0');
                }
            });

            $(".nameAdvance").each(function () {
                if ($(this).val() == '') {
                    $(this).val('-');
                }
            });

            overLayForm();
            return true;
        }

        function number_format(number) {
            var decimals = 2;
            var dec_point = '.';
            var thousands_sep = ',';
            number = number.toFixed(decimals);
            var nstr = number.toString();
            nstr += '';
            x = nstr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? dec_point + x[1] : '';
            var rgx = /(\d+)(\d{3})/;

            while (rgx.test(x1))
                x1 = x1.replace(rgx, '$1' + thousands_sep + '$2');

            return x1 + x2;
        }
    </script>
}