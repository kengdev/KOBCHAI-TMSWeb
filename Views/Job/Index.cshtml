@{
    ViewBag.TopActive = "Job";
    ViewBag.MidActive = "invoice";
    ViewBag.Title = "ข้อมูลงาน";
}
@section Styles {
    <style>
        .dataTables_filter {
            display: none;
        }

        .dataTables_length {
            /*display: none;*/
        }

        table.dataTable td,
        table.dataTable th {
            font-size: 14px !important;
        }

        .form-control {
            height: 30px !important;
            padding: 5px;
            font-size: 13px !important;
            font-weight: normal;
        }

        .action-3-td {
            width: 110px !important;
            padding-left: 2px !important;
            padding-right: 2px !important;
        }

        .form-content {
            padding-top: 20px;
            padding-left: 20px;
            padding-right: 15px;
            padding-bottom: 20px;
        }

        .form-group {
            text-align: left;
        }

            .form-group label {
                margin: 0;
                font-size: 13px;
                color: #000;
            }

        .license-driver-td {
            width: 150px;
            text-align: left;
        }
        .license-driver-td span{
            font-size:13px!important;
        }

        .datetime-td {
            width: 130px !important;
            text-align: center;
        }
    </style>
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="javascript:;">ข้อมูลงาน</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <a href="/job/">ข้อมูลงานรอเอกสาร</a>
        </li>
    </ul>
</div>
<br />
<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fad fa-list"></i>
                    <span class="caption-subject bold uppercase"> รายการงานรอเอกสาร </span>
                </div>
                <div class="actions">
                    <div class="clearfix">
                        <div class="btn-group btn-group-circle">
                            <button type="button" class="btn btn-outline blue btn-sm" onclick="setBalance()">
                                <i class="fad fa-money-check-alt"></i> รับยอด-จ่ายออก
                            </button>
                            <div class="btn-group">
                                <button type="button"
                                        class="btn btn-outline blue btn-circle-right dropdown-toggle btn-sm"
                                        data-toggle="dropdown">
                                    <i class="fad fa-download"></i> ดาวน์โหลด
                                    <i class="fa fa-angle-down"></i>
                                </button>
                                <ul class="dropdown-menu pull-right">
                                    <li>
                                        <a href="javascript:;" data-action="0" class="tool-action font-sm" onclick="setExcel()">
                                            <i class="fad fa-person-dolly font-lg"></i> รายการงานรอเอกสาร
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" data-action="0" class="tool-action font-sm" onclick="setPaymentExcel()">
                                            <i class="fad fa-money-check-edit-alt font-lg"></i> รายการจ่ายเงิน
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-6">
                    </div>

                    <div class="col-md-6">
                        <div class="form-inline pull-right">
                            <input type="text" class="form-control"
                                   value="@DateTime.Now.AddDays(-3).ToString("yyyy/MM/dd")" id="filterDateRangeStart" />
                            <span style="display:inline-block;" class="daterange-to-text">ถึง</span>

                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" value="@DateTime.Now.ToString("yyyy/MM/dd")"
                                       id="filterDateRangeEnd">
                                <span class="input-group-btn">
                                    <button class="btn green" id="btnSearch" type="button">ค้นหา</button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <table class="table table-striped table-bordered table-hover table-checkable order-column"
                           id="table-station">
                        <thead>
                            <tr>
                                <th style="text-align:center!important;"></th>
                                <th>เปิด/บรรจุ</th>
                                <th style="font-size:13px!important;"> Booking</th>
                                <th style="font-size:13px!important;"> Container</th>
                                <th>ลูกค้า</th>
                                <th> สถานที่</th>
                                <th> ทะเบียน</th>
                                <th>สังกัด</th>
                                <th>สถานะ</th>
                                <th>จ่ายเงิน</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr role="row" class="heading">
                                <th class="filter"></th>
                                <th class="filter"></th>
                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterBookingNo" />
                                </th>
                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterContainerNo" />
                                </th>
                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterCustomer" />
                                </th>
                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterMission" />
                                </th>

                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterLicense" />
                                </th>
                                <th class="filter">
                                    <input type="text" class="form-control filterText"
                                           id="filterSupplyer" />
                                </th>
                                <th class="filter">
                                    <select class="form-control filterDropdown" id="filterStatus">
                                        <option value="">--ทุกสถานะ--</option>
                                        <option value="PN">รอ</option>
                                        <option value="ST">รับงาน</option>
                                        <option value="WP">รอรับตู้</option>
                                        <option value="AR">รอเปิด/บรรจุ</option>
                                        <option value="FN">เปิด/บรรจุเรียบร้อย</option>
                                        <option value="DO">เสร็จสิ้น</option>
                                        <option value="BO">คืนตู้</option>
                                    </select>
                                </th>
                                <th class="filter"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-form-content" style="display: none;">
    <div id="form-content"></div>
</div>
@section scripts
{
    <script type="text/javascript">
        (function ($) {
            'use strict';

            const tableSelector = '#table-station';
            const statusClasses = 'PN ST WP PU AR FN DO BO';
            let filterTimer = null;

            function escapeHtml(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function getFilterValue(selector) {
                return $(selector).val() || '';
            }

            function getTrackingStatus(row) {
                switch (row.tracking_status) {
                    case 'PN':
                        return { cssClass: 'PN', text: 'รอ' };
                    case 'ST':
                        return { cssClass: 'ST', text: 'รับงาน' };
                    case 'WP':
                        return { cssClass: 'WP', text: 'รอรับตู้' };
                    case 'PU':
                        return { cssClass: 'PU', text: 'รับตู้แล้ว' };
                    case 'AR':
                        return {
                            cssClass: 'AR',
                            text: row.job_type === 'IMPORT' ? 'รอเปิด' : 'รอบรรจุ'
                        };
                    case 'FN':
                        return {
                            cssClass: 'FN',
                            text: row.job_type === 'IMPORT' || row.job_type === 'OCEAN'
                                ? 'เปิดตู้เรียบร้อย'
                                : 'บรรจุเรียบร้อย'
                        };
                    case 'DO':
                        return { cssClass: 'DO', text: 'เสร็จสิ้น' };
                    case 'BO':
                        return { cssClass: 'BO', text: 'คืนตู้' };
                    default:
                        return { cssClass: '', text: '-' };
                }
            }

            function buildActionMenu(data) {

                const id = data.job_allowance_id;
                const jobDetailCode = data.job_detail_code;

                return `
                    <div class="btn-group dropup">
                        <button type="button"
                                class="btn blue btn-xs dropdown-toggle"
                                data-toggle="dropdown"
                                aria-expanded="false">
                            เครื่องมือ
                            <i class="fa fa-angle-down"></i>
                        </button>

                        <ul class="dropdown-menu pull-left" role="menu">
                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="edit"
                                   data-code="${id}">
                                    <i class="fad fa-pencil"></i>
                                    แก้ไข
                                </a>
                            </li>
                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="update"
                                   data-code="${id}">
                                    <i class="fad fa-sync"></i>
                                    ปรับปรุงข้อมูล
                                </a>
                            </li>

                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="cashflow"
                                   data-code="${id}">
                                    <i class="fad fa-exchange-alt"></i>
                                    จ่ายเงินสำรอง
                                </a>
                            </li>

                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="finish"
                                   data-code="${id}">
                                    <i class="fad fa-file-check"></i>
                                    รับเอกสารคืน
                                </a>
                            </li>

                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="status"
                                   data-code="${jobDetailCode}">
                                    <i class="fad fa-map-signs"></i>
                                    สถานะการส่งสินค้า
                                </a>
                            </li>

                            <li>
                                <a href="#"
                                   class="js-job-action"
                                   data-action="detail"
                                   data-code="${jobDetailCode}">
                                    <i class="fad fa-clipboard-list"></i>
                                    รายละเอียด
                                </a>
                            </li>

                            <li class="divider"></li>

                            <li class="dropdown-submenu">
                                <a href="javascript:;">
                                    <i class="fad fa-print"></i>
                                    พิมพ์เอกสาร
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="#"
                                           class="js-job-action"
                                           data-action="truckDoc"
                                           data-code="${jobDetailCode}">
                                            <i class="fad fa-file-alt"></i>
                                            ใบสั่งปฏิบัติ
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#"
                                           class="js-job-action"
                                           data-action="paidDoc"
                                           data-code="${jobDetailCode}">
                                            <i class="fad fa-file-alt"></i>
                                            ใบจ่ายเงิน
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="divider"></li>

                            <li class="dropdown-submenu">
                                <a href="javascript:;">อื่น ๆ</a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="#"
                                           class="js-job-action"
                                           data-action="driver"
                                           data-code="${id}">
                                            <i class="fad fa-users"></i>
                                            เปลี่ยนพนักงานขับรถ
                                        </a>
                                    </li>

                                    <li>
                                        <a href="#"
                                           class="js-job-action"
                                           data-action="cancel"
                                           data-code="${id}">
                                            <i class="fa fa-times"></i>
                                            ยกเลิกงาน
                                        </a>
                                    </li>

                                    <li>
                                        <a href="#"
                                           class="js-job-action"
                                           data-action="remove"
                                           data-code="${jobDetailCode}">
                                            <i class="fad fa-trash"></i>
                                            ลบ
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                `;
            }

            const jobTable = $(tableSelector).DataTable({
                processing: true,
                serverSide: true,
                iDisplayLength: 20,
                scrollCollapse: false,
                searching: false,
                order: [[2, 'desc']],
                sAjaxSource: '/Job/GetJobDataList',

                fnServerParams: function (aoData) {
                    const filters = {
                        filterDateRangeStart: getFilterValue('#filterDateRangeStart'),
                        filterDateRangeEnd: getFilterValue('#filterDateRangeEnd'),
                        filterCustomer: getFilterValue('#filterCustomer'),
                        filterMission: getFilterValue('#filterMission'),
                        filterBookingNo: getFilterValue('#filterBookingNo'),
                        filterContainerNo: getFilterValue('#filterContainerNo'),
                        filterSupplier: getFilterValue('#filterSupplyer'),
                        filterLicense: getFilterValue('#filterLicense'),
                        filterStatus: getFilterValue('#filterStatus')
                    };

                    $.each(filters, function (name, value) {
                        aoData.push({
                            name: name,
                            value: value
                        });
                    });
                },

                fnRowCallback: function (row, rowData) {
                    const license = escapeHtml(rowData.truck_license || '-');
                    const driver = escapeHtml(rowData.driver_fullname || '-');
                    const truckData = `<span class="font-blue bold">${license}</span>
                        <i class="fa fa-dot-circle font-green-jungle" style="font-size:9px"></i>
                        <span class="font-blue bold">${driver}</span>`;

                    $('td', row).eq(6).html(truckData);

                    const status = getTrackingStatus(rowData);
                    $('td', row)
                        .eq(8)
                        .removeClass(statusClasses)
                        .addClass(status.cssClass)
                        .text(status.text);

                    const paymentLabel = rowData.is_advance_paid
                        ? '<span class="label label-sm label-danger">Paid</span>'
                        : '<span class="label label-sm label-warning">Pending</span>';

                    $('td', row).eq(9).html(paymentLabel);
                },

                oLanguage: {
                    sInfoFiltered: '',
                    sInfo: 'แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ รายการ',
                    sLengthMenu:
                        'แสดงจำนวน <select class="form-control">' +
                            '<option value="10">10</option>' +
                            '<option value="20" selected>20</option>' +
                            '<option value="30">30</option>' +
                            '<option value="40">40</option>' +
                            '<option value="50">50</option>' +
                            '<option value="100">100</option>' +
                        '</select> รายการ',
                    sProcessing: 'กำลังโหลดข้อมูล...',
                    sZeroRecords: 'ไม่พบข้อมูล',
                    sEmptyTable: 'ไม่มีข้อมูล'
                },

                columnDefs: [
                    {
                        className: 'dropdown-td text-left',
                        targets: 0,
                        orderable: false
                    },
                    {
                        className: 'datetime-td',
                        targets: 1,
                        orderable: false
                    },
                    {
                        className: 'booking-td',
                        targets: 2
                    },
                    {
                        className: 'container-td',
                        targets: 3
                    },
                    {
                        className: 'customer-td',
                        targets: 4
                    },
                    {
                        className: 'name-td',
                        targets: 5
                    },
                    {
                        className: 'license-driver-td',
                        targets: 6
                    },
                    {
                        className: 'status-td',
                        targets: 7
                    },
                    {
                        className: 'status-td',
                        targets: [8, 9],
                        orderable: false
                    }
                ],

                columns: [
                    {
                        data: 'job_detail_code',
                        orderable: false,
                        render: function (data, type, row) {
                            if (type !== 'display') {
                                return '';
                            }

                            return buildActionMenu(row);
                        }
                    },
                    { data: 'job_date' },
                    { data: 'booking_no' },
                    { data: 'container_no' },
                    { data: 'customer_name' },
                    { data: 'mission_name' },
                    { data: 'truck_license' },
                    { data: 'supplier_name' },
                    { data: 'tracking_status' },
                    { data: 'is_advance_paid' }
                ],

                createdRow: function (row) {
                    $(row).find('[data-toggle="tooltip"]').tooltip();
                }
            });

            function reloadTable(resetPaging) {
                jobTable.ajax.reload(null, resetPaging === true);
            }

            function setupDatePickers() {
                $('#filterDateRangeStart').datetimepicker({
                    format: 'Y/m/d',
                    timepicker: false,
                    onShow: function () {
                        this.setOptions({
                            maxDate: getFilterValue('#filterDateRangeEnd') || false
                        });
                    }
                });

                $('#filterDateRangeEnd').datetimepicker({
                    format: 'Y/m/d',
                    timepicker: false,
                    onShow: function () {
                        this.setOptions({
                            minDate: getFilterValue('#filterDateRangeStart') || false
                        });
                    }
                });
            }

            function runJobAction(action, code) {
                switch (action) {
                    case 'edit':
                        getEdit(code);
                        break;
                    case 'status':
                        getStatus(code);
                        break;
                    case 'detail':
                        getDetail(code);
                        break;
                    case 'document':
                        getDocument(code);
                        break;
                    case 'driver':
                        setDriver(code);
                        break;
                    case 'cancel':
                        setCancel(code);
                        break;
                    case 'remove':
                        setRemove(code);
                        break;
                    case 'truckDoc':
                        printJobOrder(code);
                        break;
                    case 'paidDoc':
                        printJobPayment(code);
                        break;
                    case 'update' :
                        getUpdate(code);
                        break;
                    case 'cashflow' :
                        getAdvance(code);
                        break;
                    case 'finish' :
                        getDocument(code)
                        break;
                }
            }

            setupDatePickers();
            $('#table-station tfoot tr').appendTo('#table-station thead');

            $(document).on('click', '.js-job-action', function (event) {
                event.preventDefault();

                const action = $(this).data('action');
                const code = $(this).attr('data-code');

                runJobAction(action, code);
            });

            $('.filterText').on('keyup', function (event) {
                clearTimeout(filterTimer);

                if (event.keyCode === 13) {
                    reloadTable(true);
                    return;
                }

                filterTimer = setTimeout(function () {
                    reloadTable(true);
                }, 350);
            });

            $('.filterDropdown, .dlListForm').on('change', function () {
                reloadTable(true);
            });

            $('#btnSearch').on('click', function () {
                reloadTable(true);
            });

            window.reloadRow = function () {
                reloadTable(false);
            };
        }(jQuery));
        f
        function openJobPopup(url, windowName, width, height) {
            const setting = `width=${width},height=${height}`;
            window.open(url, windowName, setting);
        }

        function showRequestError() {
            jAlert('ผลการทำงาน', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้ กรุณาลองใหม่อีกครั้ง');
        }

        function setModalLoading(isLoading) {
            $('#wrapper-action-modal').toggle(!isLoading);
            $('#spin-item').toggle(isLoading);

            if (isLoading) {
                overLayDiv('.form-content');
            } else {
                killOverlayDiv();
            }
        }

        function handleSaveResult(data) {
            if (data.result === true) {
                $.alert.open('info', data.resultMessage, function () {
                    closeModal();
                    reloadRow();
                });
            } else {
                jAlert('ผลการทำงาน', data.resultMessage);
            }
        }

        function setDriver(code) {
            openJobPopup(
                '/job/changedriver/' + encodeURIComponent(code),
                'Change Driver',
                1150,
                648
            );
        }

        function setRemove(code) {
            $.alert.open(
                'confirm',
                'คุณต้องการปิดใช้งานข้อมูลดังกล่าวนี้ ใช่หรือไม่ ?',
                function (confirmed) {
                    if (!confirmed) {
                        return;
                    }

                    overLayPage();

                    $.post('/Job/RemoveJob', {
                        job_detail_code: code
                    })
                    .done(function (data) {
                        if (data.result === true) {
                            $.alert.open('info', data.resultMessage, function () {
                                reloadRow();
                            });
                        } else {
                            jAlert('ผลการทำงาน', data.resultMessage);
                        }
                    })
                    .fail(showRequestError)
                    .always(function () {
                        killOverlayPage();
                    });
                }
            );
        }

        function getDocument(code) {
            openJobPopup(
                '/job/finish/' + encodeURIComponent(code),
                'Finished Job',
                1100,
                640
            );
        }

        function setBalance() {
            openJobPopup('/budget/settrbalance', 'Status Station', 1100, 672);
        }

        function getAdvance(id) {
            $.post('/job/updateadvance', { code: id})
                .done(function (result) {
                    $('#form-content').html(result);
                    $('#modal-form-content').modal();
                })
                .fail(showRequestError);
        }

        function setAdvance() {
            setModalLoading(true);

            $.post('/Job/UpdateAdvanceData', {
                allowance_id: $('#allowance_id').val(),
                cash_flow: $('#cash_flow').val()
            })
            .done(handleSaveResult)
            .fail(showRequestError)
            .always(function () {
                setModalLoading(false);
            });
        }

        function getUpdate(id) {
            $.post('/Job/Update', {
                code: id
            })
            .done(function (result) {
                $('#form-content').html(result);
                $('#modal-form-content').modal();
            })
            .fail(showRequestError);
        }

        function setUpdate() {
            setModalLoading(true);

            $.post('/Job/UpdateData', {
                job_date: $('#job_date').val(),
                job_detail_code: $('#job_detail_code').val(),
                container_no: $('#container_no').val(),
                seal_no: $('#seal_no').val(),
                tare_weight: $('#tare_weight').val(),
                fuel_fillup: $('#fuel_fillup').val(),
                trailer_license: $('#trailer_license').val(),
                finish_place_code: $('#finish_code').val(),
                container_size_code: $('#container_size').val(),
                job_type: $('#job_type').val(),
                supplyer_code: $('#supplyer_code').val()
            })
            .done(handleSaveResult)
            .fail(showRequestError)
            .always(function () {
                setModalLoading(false);
            });
        }

        function getEdit(code) {
            openJobPopup(
                '/job/edit/' + encodeURIComponent(code),
                'Edit Station',
                1180,
                612
            );
        }

        function closeModal() {
            $.modal.close();
        }

        function printJobOrder(code) {
            var url = "/doc/orderassignment/" + code;
            window.open(url, 'Print Station');
        }

        function printJobPayment(code) {
            var url = "/doc/cashflow/" + code;
            window.open(url, 'Print Station');
        }

        function searchPlaceFunc(type) {
            if (type === 'IMPORT') {
                url = '../search/yard';
            } else {
                url = '../search/port';
            }

            if (!url) {
                jAlert('ผลการทำงาน', 'กรุณาเลือกประเภทงานก่อน');
                return;
            }

            openJobPopup(url, 'Search Place', 900, 550);
        }

        function setYardPortBox(code) {
            $.post('../Job/GetYardPort', { code: code })
                .done(function (result) {
                    $('#finish_code').val(result.place_code);
                    $('#txtDisFinishName').val(result.place_name);
                })
                .fail(showRequestError);
        }

        function setCancel(code) {
            openJobPopup(
                '/job/canceljob/' + encodeURIComponent(code),
                'Cancel Station',
                1000,
                648
            );
        }
    </script>
}
