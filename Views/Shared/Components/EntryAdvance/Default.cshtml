@model TMSWeb.Models.Entities.LOG.TblJobcashflowAdvance
@{
    
}
    <div class="row">
        <div class="col-md-12">
                <table data-toggle="table" data-height="200" data-width="100" class="data-bootstrap">
                    <thead>
                        <tr>
                            <th data-align="center" data-width="39"></th>
                            <th data-align="left" data-width="150">รายการเงินสำรองจ่าย</th>
                            <th data-align="center">ยอดใช้จริง</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td>ค่ายก (ตู้เปล่า) </td>
                            <td>
                                @Html.TextBox("AdvanceLifton", "", new { @Class = "form-control advance-val form-box", Autocomplete="Off" })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>ค่ายก (ตู้หนัก) </td>
                            <td>
                                @Html.TextBox("AdvanceLiftoff", "", new { @Class = "form-control advance-val form-box", Autocomplete="Off"  })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>ค่าผ่านลาน</td>
                            <td>
                        @Html.TextBox("AdvanceYard", "", new { @Class = "form-control advance-val form-box", Autocomplete = "Off" })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>ค่าผ่านท่า</td>
                            <td>
                        @Html.TextBox("AdvancePort", "", new { @Class = "form-control advance-val form-box", Autocomplete = "Off" })
                            </td>
                        </tr>
                    </tbody>
                </table>
            
                <table data-toggle="table" data-height="180" data-width="100" class="data-bootstrap">
                    <thead>
                        <tr>
                            <th data-align="center" data-width="39"></th>
                            <th data-align="left" >สำรองจ่ายอื่น ๆ</th>
                            <th data-align="center" data-width="150">ยอดใช้จริง</th>
                        </tr>
                    </thead>
                    <tbody id="advance-table">
                        <tr>
                                <td style="text-align: center;">
                                    <div style="height:25px;text-align:center;padding-top:4px">
                                        <a href="javascript:;" onclick="addAdvance()"><span class="icon-plus"></span></a>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" class="form-control nameAdvance" value="" name="nameAdvance[]" autocomplete = "off">
                                </td>
                                <td>
                                    <input type="text" class="form-control form-box" name="valAdvance[]" value="" autocomplete = "off"/>
                                </td>
                        </tr>
                    </tbody>
                </table>

        </div>
    </div>