@{
ViewBag.TopActive = "Home";
ViewBag.Title = "ระบบบริหารงาน";
}
<link rel="stylesheet" type="text/css" href="~/css/bootstrap/bootstrap-table.min.css" />
<style>
    .widget-thumb-icon{
        height: 100px!important;width:100px!important;padding-top:30px!important;
    }
</style>
@if (ViewBag.Group == "01")
{
<div>
    @Html.Partial("_AdminPage")
</div>
}
else if(ViewBag.Group == "04")
{
<div>
    @Html.Partial("_OfficerPage", "Home")
</div>
}
else{
    @Html.Partial("_TransportPage", "Home")
}
@section scripts{
<script src="~/js/bootstrap/bootstrap-table.min.js" type="text/javascript"></script>
<script src="~/js/fusioncharts/js/fusioncharts.js"></script>
<script src="~/js/fusioncharts/js/fusioncharts.charts.js"></script>
<script src="~/js/fusioncharts/js/themes/fusioncharts.theme.fint.js"></script>
<script type="text/javascript">
    rendersum();
    renderhistory();

    FusionCharts.ready(function () {
        var topcustomerchart = new FusionCharts({
            type: 'column2d',
            renderAt: 'render-top-customer',
            width: '100%',
            height: '353',
            dataFormat: 'jsonurl',
            dataSource: '/dashboard/_GraphMonthlyContainerByPlace'
        }).render();

        var yealychart = new FusionCharts({
            type: 'msspline',
            renderAt: 'render-yearly-trips',
            width: '100%',
            height: '300',
            dataFormat: 'jsonurl',
            dataSource: '/dashboard/_GraphYearlyContainer'
        }).render();

        var dailychart = new FusionCharts({
            type: 'msspline',
            renderAt: 'render-daily-trips',
            width: '100%',
            height: '300',
            dataFormat: 'jsonurl',
            dataSource: '/dashboard/_GraphDailyContainer'
        }).render();
    });

    function rendersum() {
        $.post("/Dashboard/GetSum", {}, function (data) {
            var comma_separator_number_step = $.animateNumber.numberStepFactories.separator(',')
            $('#sum-net').animateNumber({
                number: data.sum_netvalue,
                numberStep: function (now, tween) {
                    var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                    $(tween.elem).text(formatted);
                }
            });
            $('#sum-billing').animateNumber({
                number: data.sum_billingvalue,
                numberStep: function (now, tween) {
                    var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                    $(tween.elem).text(formatted);
                }
            });
            $('#sum-unbilling').animateNumber({
                number: data.sum_unbillingvalue,
                numberStep: function (now, tween) {
                    var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                    $(tween.elem).text(formatted);
                }
            });
            $('#sum-uncashing').animateNumber({
                number: data.sum_uncashingvalue,
                numberStep: function (now, tween) {
                    var formatted = now.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                    $(tween.elem).text(formatted);
                }
            });
        });
    }

