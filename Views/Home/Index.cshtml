    function detail_total(code)
    {
        var setting = 'width=1100,height=665';
        url = '/dashboard/totaldetail?code=' + code;

        window.open(url, 'totaldetail dashboard', setting);
    }

    function detail_working(code)
    {
        var setting = 'width=1100,height=537';
        url = '/dashboard/workingdetail?code=' + code;

        window.open(url, 'totaldetail dashboard', setting);
    }
</script>
}